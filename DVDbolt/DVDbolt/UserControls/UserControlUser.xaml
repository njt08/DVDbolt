<UserControl x:Class="DVDbolt.UserControls.UserControlUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DVDbolt.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="570" d:DesignWidth="500">
    <StackPanel>
        <DataGrid
        x:Name="datagridfelhasznalok"
        Width="500"
        Height="350"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        IsReadOnly="True"
        SelectionChanged="datagridfelhasznalok_SelectionChanged_1">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding ID}" Header="ID" />
                <DataGridTextColumn Binding="{Binding FelhasznaloNev}" Header="Felhasználónév" />
                <DataGridTextColumn Binding="{Binding Jelszo}" Header="Jelszo" />
                <DataGridTextColumn Binding="{Binding TeljesNev}" Header="Teljesnév" />
                <DataGridTextColumn Binding="{Binding Szerepkor}" Header="Szerepkör id" />
                <DataGridTextColumn Binding="{Binding SzerepkorNev}" Header="Szerepkör név" />
            </DataGrid.Columns>

        </DataGrid>
        <WrapPanel Margin="130,10,130,0">
            <StackPanel Width="300" Background="LightGray">
                <TextBlock>Felhasználónév:</TextBlock>
                <TextBox x:Name="felhasznalonevText" />
                <TextBlock>Teljes név:</TextBlock>
                <TextBox x:Name="teljesnevText" />
                <TextBlock>Jelszó:</TextBlock>
                <PasswordBox x:Name="jelszoText" />
                <TextBlock>Szerepkör</TextBlock>
                <ComboBox x:Name="szerepkorComboBox" />
            </StackPanel>
            <StackPanel>
                <Button
                x:Name="mentesBtn"
                Width="200"
                Background="Green"
                Click="mentesBtn_Click"
                Content="Mentés"
                Foreground="White"
                Visibility="Visible" />
                <Button
                x:Name="torlesBtn"
                Width="200"
                Background="Red"
                Click="torlesBtn_Click"
                Content="Törlés"
                Foreground="White"
                Visibility="Hidden" />
                <Button
                x:Name="modBtn"
                Width="200"
                Background="Yellow"
                Click="modBtn_Click"
                Content="Módostás"
                Foreground="White"
                Visibility="Hidden" />
            </StackPanel>
        </WrapPanel>
    </StackPanel>
</UserControl>